{
  "name": "gsd-explicit-reactive",
  "version": "5.1.0",
  "description": "Deterministic DAG-based parallel task dispatch for GSD auto-mode.",
  "type": "module",
  "exports": "./index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "prepare": "husky"
  },
  "keywords": [
    "pi-package",
    "gsd-extension",
    "dag",
    "auto-mode"
  ],
  "gsd": {
    "extension": true
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "lint-staged": {
    "**/*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
